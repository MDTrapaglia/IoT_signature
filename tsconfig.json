{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./offchain",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": [
    "offchain/backend/**/*",
    "offchain/transactions/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "offchain/frontend",
    "offchain/backend/srial_index.ts",
    "offchain/transactions/experiments/**/*",
    "offchain/transactions/*meshjs*.ts",
    "offchain/transactions/consume_ecdsa_utxo_meshjs.ts",
    "offchain/transactions/test_ecdsa_onchain.ts",
    "offchain/transactions/test_ed25519_consume.ts",
    "offchain/transactions/test_simple_consume.ts",
    "offchain/transactions/test_simple_validator.ts",
    "offchain/transactions/test_oracle_consume.ts",
    "offchain/transactions/test_update_manual.ts",
    "offchain/transactions/mint_sensor_nft.ts",
    "offchain/transactions/create_oracle.ts",
    "offchain/transactions/update_oracle.ts",
    "offchain/transactions/delete_oracle.ts",
    "offchain/transactions/consume_ecdsa_utxo_lucid.ts",
    "offchain/transactions/utils/convert_key.ts"
  ]
}
